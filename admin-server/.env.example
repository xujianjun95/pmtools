# pmtools-admin 配置示例：复制为 .env 并按环境填写（.env 已被 git 忽略，权限建议 600）
PORT=3200
DB_PATH=/opt/pmtools-admin/articles.db

# 单管理员密码；更换后须同步轮换 SESSION_SECRET 并重启服务，旧会话才会失效
ADMIN_PASSWORD=
SESSION_SECRET=

# 写操作 Origin/Referer 白名单，逗号分隔（本地联调默认含 http://localhost:5173）
ADMIN_ALLOWED_ORIGINS=https://www.pmtools.com.cn,https://pmtools.com.cn

# 阿里云 OSS（图片转传；凭据只存本文件，勿入 Git）
OSS_REGION=oss-cn-beijing
OSS_BUCKET=pmtools27
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 图片目录前缀：本地联调时改为 test/images 与生产隔离
OSS_IMAGES_PREFIX=articles/images

# 看板只读挂载的 qdii-notify 数据库（生产默认在 /opt/qdii-notify/ 下）
QDII_DB_PATH=/opt/qdii-notify/subscribers.db
QDII_ANALYTICS_DB_PATH=/opt/qdii-notify/subscribers.db.analytics.db
