# ===== QDII 通知服务配置模板 =====
# 复制为 .env 并填写真实值（.env 不要提交到 git）

# 服务监听端口（nginx 反代指向这里）
PORT=3100

# 被监控的 data.json 绝对路径（scanner.py --out 的输出位置）
DATA_JSON_PATH=/var/www/pmtools/main/qdii/data.json

# 本次状态快照文件（服务自己保存"已通知状态"用，运行时自动创建）
SNAPSHOT_PATH=/opt/qdii-notify/snapshot.json

# SQLite 数据库文件（订阅者列表）
DB_PATH=/opt/qdii-notify/subscribers.db

# ---- 发送通道 ----
# aliyun：阿里云邮件推送 API（推荐，默认）
# smtp：标准 SMTP（nodemailer，备用，如 smtpdm.aliyun.com:465）
MAIL_PROVIDER=aliyun

# ---- 阿里云邮件推送（MAIL_PROVIDER=aliyun 时必填）----
# 与 Dang Analysis 共用同一套 AccessKey（dang-rag/.env 里也有）
ALIYUN_DM_ACCESS_KEY_ID=your_access_key_id
ALIYUN_DM_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_DM_ENDPOINT=dm.aliyuncs.com
# 发信地址（DM 控制台已创建的，如 noreply@mail.pmtools.com.cn）
ALIYUN_DM_FROM_ADDRESS=noreply@mail.pmtools.com.cn

# ---- SMTP（MAIL_PROVIDER=smtp 时必填：阿里云 DM 的 SMTP 端点）----
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
# 发信地址本身即认证用户名，密码是 DM 控制台为该地址设置的 SMTP 密码
SMTP_USER=noreply@mail.pmtools.com.cn
SMTP_PASS=your_smtp_password

# 发件人显示名（可选）
MAIL_FROM_NAME=QDII额度监控

# ---- 公网站点（退订链接用完整 URL，务必填域名）----
PUBLIC_BASE_URL=https://pmtools.example.com

# 定时检测时间（cron 格式，默认每天 1:10 与 12:10 运行，配合 scanner 的 1:00/12:00）
NOTIFY_CRON=10 1,12 * * *

# 单批发送上限（aliyun 模式下每封独立调用，此值控制并发批大小）
BATCH_SIZE=50
